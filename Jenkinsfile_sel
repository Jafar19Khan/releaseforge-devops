// Optional browser-test pipeline. Configure Python, Selenium and Chrome/Chromium
// on the selected Jenkins agent before running this pipeline.
pipeline {
    agent { label 'slave2' }
    options { timestamps(); disableConcurrentBuilds() }
    stages {
        stage('Checkout') { steps { checkout scm } }
        stage('Build and run') {
            steps {
                sh '''set -eu
                    docker build -t releaseforge-demo:selenium .
                    docker rm -f releaseforge-selenium-test 2>/dev/null || true
                    docker run -d --name releaseforge-selenium-test -p 8082:80 releaseforge-demo:selenium
                '''
            }
        }
        stage('Browser smoke test') {
            steps { sh 'python3 -m pip install --user -r requirements-test.txt && python3 selenium_test.py http://127.0.0.1:8082/devopsIQ/' }
        }
    }
    post { always { sh 'docker rm -f releaseforge-selenium-test 2>/dev/null || true' } }
}
